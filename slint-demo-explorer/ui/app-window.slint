import { Button, LineEdit } from "std-widgets.slint";
import { UiTree, TreeNode } from "ui_tree.slint";
import { UiList, ListColumn, ListRow } from "ui_list.slint";

export component AppWindow inherits Window {
    title: "Slint Explorer Demo";
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 440px;
    background: #171a21;

    in-out property <[TreeNode]> tree-nodes;
    in-out property <[ListColumn]> list-columns;
    in-out property <[ListRow]> list-rows;
    in-out property <string> list-focused-id;
    in-out property <string> list-status-text;
    in-out property <string> list-operation-status;
    in-out property <image> list-status-icon;
    in-out property <bool> list-has-status-icon: false;
    in-out property <length> list-status-icon-size: 16px;
    in-out property <string> location;
    callback navigate-up();
    callback navigate-to(string);
    callback tree-selected(string);
    callback tree-expansion-toggled(string);
    callback tree-activated(string);
    callback list-selected(string);
    callback list-selection-requested(string, int);
    callback list-drag-start-requested(string);
    callback list-selection-dragged(string);
    callback list-focus-requested(string);
    callback list-activated(string);
    callback list-context-menu-requested(string, length, length);
    callback list-command-requested(int);
    callback list-column-resized(string, length);

    Rectangle {
        background: #171a21;
        VerticalLayout {
            spacing: 0px;
            // This header's dimensions match FrameConfig in main.rs. Win32
            // handles dragging on its left side; these buttons remain Slint UI.
            Rectangle {
                height: 44px;
                background: #202630;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text {
                        text: "Slint Explorer Demo";
                        color: #d9e0ea;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button { text: "-"; clicked => { root.minimized = true; } }
                    Button { text: "Max"; clicked => { root.maximized = !root.maximized; } }
                    Button { text: "Close"; clicked => { root.close(); } }
                }
            }
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Up"; clicked => { root.navigate-up(); } }
                    location-input := LineEdit {
                        text: root.location;
                        accepted => { root.navigate-to(self.text); }
                        horizontal-stretch: 1;
                    }
                    Button { text: "Go"; clicked => { root.navigate-to(location-input.text); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    tree := UiTree {
                        width: 230px;
                        nodes: root.tree-nodes;
                        selected(id) => { root.tree-selected(id); }
                        expansion-toggled(id) => { root.tree-expansion-toggled(id); }
                        activated(id) => { root.tree-activated(id); }
                    }
                    list := UiList {
                        horizontal-stretch: 1;
                        columns: root.list-columns;
                        rows: root.list-rows;
                        focused-id: root.list-focused-id;
                        status-visible: true;
                        status-at-top: true;
                        corner-radius: 10px;
                        selected(id) => { root.list-selected(id); }
                        selection-requested(id, mode) => { root.list-selection-requested(id, mode); }
                        drag-start-requested(id) => { root.list-drag-start-requested(id); }
                        selection-dragged(id) => { root.list-selection-dragged(id); }
                        focus-requested(id) => { root.list-focus-requested(id); }
                        activated(id) => { root.list-activated(id); }
                        context-menu-requested(id, x, y) => { root.list-context-menu-requested(id, x, y); }
                        command-requested(command) => { root.list-command-requested(command); }
                        column-resized(id, width) => { root.list-column-resized(id, width); }
                        // Default UiList children are its status slot. This
                        // host controls all of its content and arrangement.
                        Rectangle {
                            background: #202630;
                            // This caller currently puts its status at the
                            // top, so it owns the matching outer corners too.
                            border-top-left-radius: 10px;
                            border-top-right-radius: 10px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                if root.list-has-status-icon : Rectangle {
                                    width: root.list-status-icon-size;
                                    Image {
                                        width: parent.width;
                                        height: root.list-status-icon-size;
                                        y: (parent.height - self.height) / 2;
                                        source: root.list-status-icon;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: root.list-status-text;
                                    color: #aab5c6;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    width: 250px;
                                    text: root.list-operation-status;
                                    color: #d9e0ea;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
