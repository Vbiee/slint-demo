// === UiList contract ========================================================
// DEPENDENCY: ui_scroll_view.slint (ListView). Rust helper: src/ui_list.rs.
// HOST OWNS: bounded component size, data/models, selected IDs, focus, anchor,
// application commands and icons. UiList renders and emits requests only.
//
// DATA INPUTS
// - columns: [ListColumn], stable unique id, title, width (negative = stretch),
//   min-width, alignment (0 left, 1 center, 2 right), resizable. Header/cell
//   text and background colors each have a corresponding has-* flag.
// - rows: [ListRow], stable unique id, selected, and cells in column order.
//   Extra cells are ignored; missing cells are empty. ListCell has text, icon,
//   has-icon, icon-size, text/background colors and their has-* flags. Cell
//   colors override column colors; text then falls back to selection/hover/theme.
// - focused-id: caller's focused row; its border appears while list has focus.
//   Update rows[].selected and focused-id in response to requests; neither is
//   maintained by UiList. keyboard-page-size defaults to 10 rows.
//
// INPUT/OUTPUT: content-x, content-y are scroll offsets (negative when scrolled
// right/down). Bind them only if the caller needs to observe/restore scroll.
//
// CALLBACKS (host must connect the features it wants)
// - selection-requested(id, mode): 0 replace/reset anchor, 1 toggle, 2 extend
//   from the host's anchor. Host computes the selection and republishes rows.
// - focus-requested(id): update focused-id; does not itself select a row.
// - activated(id): double-click or Enter; host decides the action.
// - context-menu-requested(id, x, y): right mouse down; coordinates are relative
//   to the window. Host decides selection policy and opens the menu.
// - command-requested(code): 1 rename/F2, 2 delete, 3 copy/Ctrl+C,
//   4 cut/Ctrl+X, 5 paste/Ctrl+V, 6 select all/Ctrl+A, 7 clear/Escape.
// - column-resized(id, width): committed on release; persist width in columns.
// - selected(id): exposed for compatibility, but not emitted by this component.
//
// OPTIONAL INPUTS: header-height 32px, row-height 34px, row-gap 2px,
// row-corner-radius 4px, horizontal-padding/field-horizontal-padding 6px,
// icon-text-gap 6px, corner-radius 0px; color properties are declared below.
// status-visible defaults false; status-at-top false; status-height 26px.
// @children is the status content, owned and laid out by the caller.
//
// BEHAVIOR/LIMITS: rows use a virtualized ListView. Arrow/Home/End/Page keys
// request focus and selection; Ctrl+arrow requests focus only. Plain drag emits
// range requests; Ctrl+drag currently acts as Ctrl+click, not additive drag.
// The red outer debug border is currently hard-coded. Rust Port implementations
// must forward callbacks: a no-op adapter method silently discards that feature.
import { ListView } from "ui_scroll_view.slint";

// Generic table schema. width: -1px means this column shares remaining space
// with other auto-width columns; alignment: 0 = left, 1 = center, 2 = right.
export struct ListColumn {
    // Stable ID for column resize events; unique within columns.
    id: string,
    // Header text.
    title: string,
    // Nonnegative fixed logical width; any negative value enables stretch.
    width: length,
    // Minimum drag width and starting width for a stretched column.
    min-width: length,
    // Header and cell alignment: 0 left, 1 center, 2 right.
    alignment: int,
    // Show resize handle and emit column-resized on release.
    resizable: bool,
    // Cell text default and enable flag; a cell override has priority.
    text-color: color,
    has-text-color: bool,
    // Cell fill default and enable flag; a cell override has priority.
    background-color: color,
    has-background-color: bool,
    // Header text override and enable flag.
    header-text-color: color,
    has-header-text-color: bool,
    // Header fill override and enable flag.
    header-background-color: color,
    has-header-background-color: bool,
}

export struct ListCell {
    // Cell text; model index corresponds to the column index.
    text: string,
    // An optional caller-owned image. UiList only lays it out; it never loads
    // icons or infers them from the text/row.
    icon: image,
    // Show icon only when true; icon-size is its square logical size.
    has-icon: bool,
    icon-size: length,
    // Per-cell text override and enable flag.
    text-color: color,
    has-text-color: bool,
    // Per-cell background override and enable flag.
    background-color: color,
    has-background-color: bool,
}

export struct ListRow {
    // Stable ID returned by interaction callbacks.
    id: string,
    // Ordered to match columns; absent cells are empty, extra cells ignored.
    cells: [ListCell],
    // Caller-owned selection flag used for row styling.
    selected: bool,
}

component HeaderColumn inherits Rectangle {
    in property <ListColumn> column;
    in property <color> text-color;
    // `effective-*` is normally derived from `column`, but can be a local
    // preview while a resize is in progress.  Keeping that preview inside the
    // list prevents a host model update from recreating this delegate mid-drag.
    in property <length> effective-width;
    in property <bool> effective-auto-stretch;
    // Horizontal inset within each field.
    in property <length> field-horizontal-padding;
    callback resize-preview(string, length);
    callback resize-committed(string, length);
    callback resize-cancelled();

    width: root.effective-width;
    horizontal-stretch: root.effective-auto-stretch ? 1 : 0;

    Rectangle {
        background: root.column.has-header-background-color ? root.column.header-background-color : transparent;
        border-radius: 2px;
        x: 1px;
        y: 2px;
        width: parent.width - 2px;
        height: parent.height - 4px;
    }
    Text {
        x: root.field-horizontal-padding;
        width: parent.width - 2 * root.field-horizontal-padding;
        height: parent.height;
        text: root.column.title;
        color: root.column.has-header-text-color ? root.column.header-text-color : root.text-color;
        horizontal-alignment: root.column.alignment == 2 ? right : (root.column.alignment == 1 ? center : left);
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        visible: root.column.resizable;
        x: parent.width - 1px;
        width: 1px;
        height: parent.height - 8px;
        y: 4px;
        background: #59627355;
    }
    resize-hit := TouchArea {
        visible: root.column.resizable;
        x: parent.width - 5px;
        width: 10px;
        height: parent.height;
        mouse-cursor: ew-resize;
        property <length> start-width;
        property <length> start-pointer-x;
        property <length> dragged-width;
        property <bool> resizing: false;
        property <bool> has-preview: false;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.start-width = parent.width;
                // The resize handle moves with the column. Keep pointer
                // coordinates in window space to avoid a feedback loop.
                self.start-pointer-x = self.absolute-position.x + self.mouse-x;
                self.dragged-width = self.start-width;
                self.resizing = true;
                self.has-preview = false;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (self.resizing && self.has-preview) {
                    root.resize-committed(root.column.id, self.dragged-width);
                }
                self.resizing = false;
                self.has-preview = false;
            }
            if (event.kind == PointerEventKind.cancel) {
                if (self.resizing && self.has-preview) {
                    root.resize-cancelled();
                }
                self.resizing = false;
                self.has-preview = false;
            }
        }
        moved => {
            if (self.pressed && self.resizing) {
                self.dragged-width = max(root.column.min-width,
                    self.start-width + (self.absolute-position.x + self.mouse-x)
                        - self.start-pointer-x);
                self.has-preview = true;
                root.resize-preview(root.column.id, self.dragged-width);
            }
        }
    }
}

// Generic, virtualized data list. The caller owns schema and row data; this
// component only renders it and emits semantic selection/resize events.
export component UiList inherits Rectangle {
    // Ordered caller-owned column schema.
    in property <[ListColumn]> columns;
    // Ordered caller-owned row model including selected flags.
    in property <[ListRow]> rows;
    // Height of the column header.
    in property <length> header-height: 32px;
    // Visible row height, excluding row-gap.
    in property <length> row-height: 34px;
    // Spacing reserved around each row.
    in property <length> row-gap: 2px;
    // Radius of selection/hover row fill.
    in property <length> row-corner-radius: 4px;
    // Outer space belongs to the whole table; every field gets its own
    // symmetric inset so adjacent columns do not render flush to each other.
    // Horizontal inset around the entire row/header layout.
    in property <length> horizontal-padding: 6px;
    in property <length> field-horizontal-padding: 6px;
    // Background of the header strip.
    in property <color> header-background-color: #252b36;
    // Default column header text color.
    in property <color> header-text-color: #b8c2d1;
    // Default normal cell text color.
    in property <color> row-text-color: #d9e0ea;
    // Hovered unselected row fill.
    in property <color> hover-row-color: #273443;
    // Fallback text color for hovered unselected rows.
    in property <color> hover-text-color: #f0f4fa;
    // Focused row border color while list has keyboard focus.
    in property <color> focused-row-border-color: #8ab4f8;
    // Selected row fill.
    in property <color> selected-row-color: #304c70;
    // Fallback text color of selected rows.
    in property <color> selected-text-color: #f4f7fb;
    // Gap between a cell's icon and text.
    in property <length> icon-text-gap: 6px;
    // The default component slot is the status area. The caller owns every
    // visual inside it; UiList only reserves and positions that area.
    // Reserve and display caller's status slot.
    in property <bool> status-visible: false;
    // True places status above header; false places it below rows.
    in property <bool> status-at-top: false;
    // Height reserved for visible status.
    in property <length> status-height: 26px;
    // Outer border/clip corner radius.
    in property <length> corner-radius: 0px;
    // Caller-owned selection state. Modes emitted below: 0 replace, 1 toggle,
    // 2 extend from the caller's selection anchor.
    // Caller-owned focused row ID.
    in property <string> focused-id: "";
    // Number of rows to move with PageUp/PageDown.
    in property <int> keyboard-page-size: 10;
    // Read/write horizontal scroll offset; negative when scrolled right.
    in-out property <length> content-x: 0px;
    // Read/write vertical scroll offset; negative when scrolled down.
    in-out property <length> content-y: 0px;
    // Resizing is a purely local preview.  The host receives one committed
    // width only after the pointer is released.
    private property <string> resizing-column-id: "";
    private property <length> resizing-column-width: 0px;
    callback selected(string);
    callback selection-requested(string, int);
    callback focus-requested(string);
    callback activated(string);
    callback context-menu-requested(string, length, length);
    // 1 rename, 2 delete, 3 copy, 4 cut, 5 paste, 6 select-all, 7 clear.
    callback command-requested(int);
    callback column-resized(string, length);

    background: #171a21;
    // Debug boundary: this is the complete area owned and painted by UiList.
    border-color: #ff3b30;
    border-width: 1px;
    border-radius: root.corner-radius;
    clip: true;
    forward-focus: focus-scope;

    private property <int> keyboard-index: -1;
    // A mouse range gesture is translated into the same semantic range
    // requests as Shift+click.  Selection state itself remains caller-owned.
    private property <int> drag-last-index: -1;
    callback request-focus(int);
    callback extend-drag-selection(int);
    extend-drag-selection(index) => {
        let target = max(0, min(root.rows.length - 1, index));
        if (target != root.drag-last-index && target >= 0) {
            root.drag-last-index = target;
            root.keyboard-index = target;
            root.focus-requested(root.rows[target].id);
            root.selection-requested(root.rows[target].id, 2);
        }
    }
    request-focus(index) => {
        root.keyboard-index = max(0, min(root.rows.length - 1, index));
        if (root.keyboard-index >= 0) {
            // `content-y` is negative when scrolled down. Keep the complete
            // focused row inside ListView's current viewport.
            if (root.keyboard-index * (root.row-height + root.row-gap) < -root.content-y) {
                root.content-y = -root.keyboard-index * (root.row-height + root.row-gap);
            } else if ((root.keyboard-index + 1) * (root.row-height + root.row-gap)
                       > -root.content-y + list.visible-height) {
                root.content-y = -((root.keyboard-index + 1) * (root.row-height + root.row-gap)
                    - list.visible-height);
            }
            root.focus-requested(root.rows[root.keyboard-index].id);
        }
    }

    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.request-focus(root.keyboard-index - 1); }
            else if (event.text == Key.DownArrow) { root.request-focus(root.keyboard-index + 1); }
            else if (event.text == Key.Home) { root.request-focus(0); }
            else if (event.text == Key.End) { root.request-focus(root.rows.length - 1); }
            else if (event.text == Key.PageUp) { root.request-focus(root.keyboard-index - root.keyboard-page-size); }
            else if (event.text == Key.PageDown) { root.request-focus(root.keyboard-index + root.keyboard-page-size); }
            else if (event.text == Key.Return) { if (root.keyboard-index >= 0) { root.activated(root.rows[root.keyboard-index].id); } return accept; }
            else if (event.text == Key.F2) { root.command-requested(1); return accept; }
            else if (event.text == Key.Delete) { root.command-requested(2); return accept; }
            else if (event.modifiers.control && event.text == "a") { root.command-requested(6); return accept; }
            else if (event.modifiers.control && event.text == "c") { root.command-requested(3); return accept; }
            else if (event.modifiers.control && event.text == "x") { root.command-requested(4); return accept; }
            else if (event.modifiers.control && event.text == "v") { root.command-requested(5); return accept; }
            else if (event.text == Key.Escape) { root.command-requested(7); return accept; }
            else { return reject; }
            if (root.keyboard-index >= 0 && !event.modifiers.control) {
                root.selection-requested(root.rows[root.keyboard-index].id, event.modifiers.shift ? 2 : 0);
            }
            accept
        }
    }

    header := Rectangle {
        x: 0px;
        y: root.status-visible && root.status-at-top ? root.status-height : 0px;
        width: parent.width;
        height: root.header-height;
        background: root.header-background-color;
        clip: true;
        border-top-left-radius: root.status-visible && root.status-at-top ? 0px : root.corner-radius;
        border-top-right-radius: root.status-visible && root.status-at-top ? 0px : root.corner-radius;
            header-content := Rectangle {
                x: root.content-x;
                width: max(root.width, list.content-width);
                height: parent.height;
                HorizontalLayout {
                    padding-left: root.horizontal-padding;
                    padding-right: root.horizontal-padding;
                    for column in root.columns : HeaderColumn {
                        column: column;
                        text-color: root.header-text-color;
                        field-horizontal-padding: root.field-horizontal-padding;
                        effective-width: root.resizing-column-id == column.id
                            ? root.resizing-column-width
                            : (column.width < 0px ? column.min-width : column.width);
                        effective-auto-stretch: root.resizing-column-id != column.id
                            && column.width < 0px;
                        resize-preview(id, width) => {
                            root.resizing-column-id = id;
                            root.resizing-column-width = width;
                        }
                        resize-committed(id, width) => {
                            root.column-resized(id, width);
                            root.resizing-column-id = "";
                        }
                        resize-cancelled => {
                            root.resizing-column-id = "";
                        }
                    }
                }
            }
    }
    // ListView virtualizes this direct repeater while retaining the
    // project-owned scrollbar from ui_scroll_view.slint.
    list := ListView {
        x: 0px;
        y: header.y + header.height;
        width: parent.width;
        height: parent.height - self.y
            - (root.status-visible && !root.status-at-top ? root.status-height : 0px);
        content-x <=> root.content-x;
        content-y <=> root.content-y;
        for row[index] in root.rows : Rectangle {
                height: root.row-height + root.row-gap;
                // This is declared before the visual row so the latter can
                // consume its hover state while the TouchArea still owns the
                // semantic selection/activation interaction.
                row-hover := TouchArea {
                    y: root.row-gap / 2;
                    width: parent.width;
                    height: root.row-height;
                    property <int> selection-mode: 0;
                    property <bool> selection-applied: false;
                    property <length> press-window-y: 0px;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            self.selection-mode = event.modifiers.shift ? 2
                                : (event.modifiers.control ? 1 : 0);
                            self.selection-applied = false;
                            root.keyboard-index = index;
                            focus-scope.focus();
                            root.focus-requested(row.id);
                            if (event.button == PointerEventButton.left) {
                                // Commit the starting item now. A subsequent
                                // pointer drag can then use it as the host's
                                // range anchor without keeping local state.
                                root.drag-last-index = index;
                                root.selection-requested(row.id, self.selection-mode);
                                self.selection-applied = true;
                                self.press-window-y = self.absolute-position.y + self.mouse-y;
                            } else if (event.button == PointerEventButton.right) {
                                root.context-menu-requested(row.id,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            root.drag-last-index = -1;
                        }
                    }
                    moved => {
                        // A small threshold preserves ordinary click and
                        // double-click behavior. Ctrl+drag deliberately stays
                        // a Ctrl-click: additive/toggle range semantics need a
                        // separate host policy and are not guessed by UiList.
                        if (self.pressed && self.selection-mode != 1
                            && abs(self.absolute-position.y + self.mouse-y - self.press-window-y) >= 4px) {
                            // Keep extending a range while crossing a viewport
                            // edge. Flickable clamps content-y to its actual
                            // scroll range; one row per pointer update keeps
                            // the gesture controllable instead of jumping.
                            if (self.absolute-position.y + self.mouse-y < list.absolute-position.y) {
                                root.content-y = min(0px, root.content-y
                                    + root.row-height + root.row-gap);
                            } else if (self.absolute-position.y + self.mouse-y
                                > list.absolute-position.y + list.visible-height) {
                                root.content-y = root.content-y
                                    - root.row-height - root.row-gap;
                            }
                            root.extend-drag-selection(floor(
                                (self.absolute-position.y + self.mouse-y
                                    - list.absolute-position.y - root.content-y)
                                / (root.row-height + root.row-gap)
                            ));
                        }
                    }
                    clicked => {
                        if (!self.selection-applied) {
                            root.selection-requested(row.id, self.selection-mode);
                        }
                    }
                    double-clicked => { root.activated(row.id); }
                }
                row-background := Rectangle {
                    y: root.row-gap / 2;
                    height: root.row-height;
                    width: parent.width;
                    background: row.selected ? root.selected-row-color
                        : (row-hover.has-hover ? root.hover-row-color : transparent);
                    border-radius: root.row-corner-radius;
                    border-color: root.focused-id == row.id && focus-scope.has-focus
                        ? root.focused-row-border-color : transparent;
                    border-width: root.focused-id == row.id && focus-scope.has-focus ? 1px : 0px;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: root.horizontal-padding;
                        padding-right: root.horizontal-padding;
                        for column[index] in root.columns : Rectangle {
                            property <ListCell> cell: index < row.cells.length
                                ? row.cells[index]
                                : { text: "", icon: @image-url(""), has-icon: false, icon-size: 0px, text-color: transparent, has-text-color: false, background-color: transparent, has-background-color: false };
                            width: root.resizing-column-id == column.id
                                ? root.resizing-column-width
                                : (column.width < 0px ? column.min-width : column.width);
                            horizontal-stretch: root.resizing-column-id != column.id
                                && column.width < 0px ? 1 : 0;
                            background: self.cell.has-background-color ? self.cell.background-color : (column.has-background-color ? column.background-color : transparent);
                            Image {
                                visible: parent.cell.has-icon;
                                x: root.field-horizontal-padding;
                                y: (parent.height - self.height) / 2;
                                width: parent.cell.icon-size;
                                height: parent.cell.icon-size;
                                source: parent.cell.icon;
                                image-fit: contain;
                            }
                            Text {
                                x: root.field-horizontal-padding + (parent.cell.has-icon
                                    ? parent.cell.icon-size + root.icon-text-gap
                                    : 0px);
                                width: parent.width - self.x - root.field-horizontal-padding;
                                height: parent.height;
                                text: parent.cell.text;
                                color: parent.cell.has-text-color ? parent.cell.text-color
                                    : (column.has-text-color ? column.text-color
                                        : (row.selected ? root.selected-text-color
                                            : (row-hover.has-hover ? root.hover-text-color : root.row-text-color)));
                                horizontal-alignment: column.alignment == 2 ? right : (column.alignment == 1 ? center : left);
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
    }
    status-bar := Rectangle {
        visible: root.status-visible;
        x: 0px;
        y: root.status-at-top ? 0px : parent.height - self.height;
        width: parent.width;
        height: root.status-height;
        clip: true;
        status-content := Rectangle {
            width: parent.width;
            height: parent.height;
            @children
        }
    }
}
