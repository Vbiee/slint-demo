// REQUIRED: Slint runtime; no other project module. Embed full-parent size.
// INPUTS: open (false), title, message, confirm-label ("Confirm"),
// cancel-label ("Cancel"). CALLBACKS: confirmed() and cancelled() (cancel
// button or backdrop); host executes actions and updates open. Card size,
// colors and layout are currently hard-coded. Optional Rust modal adapter in
// src/overlays/modal.rs depends on this demo's generated AppWindow.
// Generic modal: caller owns visibility, content strings, and action logic.
export component UiModal inherits Rectangle {
    // Host-owned visibility; callbacks do not change this value.
    in property <bool> open: false;
    // Card heading text.
    in property <string> title;
    // Card body text, word-wrapped.
    in property <string> message;
    // Confirm button text.
    in property <string> confirm-label: "Confirm";
    // Cancel button text.
    in property <string> cancel-label: "Cancel";
    // User pressed confirm; host performs the action and closes if desired.
    callback confirmed();
    // User pressed cancel or the scrim; host changes open if desired.
    callback cancelled();

    visible: root.open;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #080b10b8;
        TouchArea { clicked => { root.cancelled(); } }
    }

    card := Rectangle {
        width: min(440px, parent.width - 32px);
        height: 218px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #252b36;
        border-color: #465266;
        border-width: 1px;
        border-radius: 10px;

        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text { text: root.title; color: #f2f6fc; font-size: 18px; font-weight: 600; }
            Text { text: root.message; color: #b5c0d0; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                cancel := Rectangle {
                    width: 88px; height: 34px; border-radius: 5px; background: #374151;
                    Text { text: root.cancel-label; color: #e2e8f0; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.cancelled(); } }
                }
                confirm := Rectangle {
                    width: 98px; height: 34px; border-radius: 5px; background: #3478c6;
                    Text { text: root.confirm-label; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.confirmed(); } }
                }
            }
        }
    }
}
