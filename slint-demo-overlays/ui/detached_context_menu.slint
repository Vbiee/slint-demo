import { ContextMenuItem } from "ui_context_menu.slint";

// A native window with a selectable presentation. It deliberately has no
// relationship to the AppWindow scene graph, so it can extend beyond the
// caller's bounds.
export component DetachedContextMenu inherits Window {
    title: "Context menu";
    no-frame: !root.use-native-frame;
    always-on-top: true;
    preferred-width: root.menu-width;
    min-width: root.menu-width;
    max-width: root.menu-width;
    preferred-height: min(root.menu-max-height, root.menu-padding * 2 + root.items.length * (root.entry-height + root.entry-spacing));
    min-height: root.menu-padding * 2 + root.entry-height;
    max-height: root.menu-max-height;
    background: root.menu-background;

    in-out property <[ContextMenuItem]> items;
    // A Win32 frame retains the native DWM shadow for a square menu. Rounded
    // menus are frameless because their transparent alpha edge replaces it.
    in-out property <bool> use-native-frame: true;
    in-out property <length> corner-radius: 0px;
    in-out property <length> menu-width: 204px;
    in-out property <length> menu-max-height: 320px;
    in-out property <length> menu-padding: 6px;
    in-out property <length> entry-spacing: 2px;
    in-out property <length> menu-border-width: 1px;
    in-out property <color> menu-background: #2a313d;
    in-out property <color> menu-border-color: #4a576b;
    in-out property <length> entry-height: 32px;
    in-out property <length> entry-corner-radius: 4px;
    in-out property <length> entry-text-left-padding: 10px;
    in-out property <length> entry-border-width: 0px;
    in-out property <color> entry-background: transparent;
    in-out property <color> entry-border-color: transparent;
    in-out property <color> entry-hover-background: #3b4d64;
    in-out property <color> entry-text-color: #e7edf6;
    in-out property <color> entry-disabled-text-color: #6e7888;
    in-out property <color> entry-danger-text-color: #ff9a9a;
    callback item-triggered(string);

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.menu-background;
        border-color: root.menu-border-color;
        border-width: root.menu-border-width;
        border-radius: root.corner-radius;
        clip: true;

        VerticalLayout {
            padding: root.menu-padding;
            spacing: root.entry-spacing;
            for item in root.items : Rectangle {
                height: root.entry-height;
                border-radius: root.entry-corner-radius;
                background: row-hit.has-hover && item.enabled ? root.entry-hover-background : root.entry-background;
                border-width: root.entry-border-width;
                border-color: root.entry-border-color;
                Text {
                    x: root.entry-text-left-padding;
                    text: item.label;
                    color: !item.enabled ? root.entry-disabled-text-color : (item.danger ? root.entry-danger-text-color : root.entry-text-color);
                    vertical-alignment: center;
                }
                row-hit := TouchArea {
                    enabled: item.enabled;
                    clicked => { root.item-triggered(item.id); }
                }
            }
        }
    }
}
