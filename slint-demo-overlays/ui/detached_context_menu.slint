import { ContextMenuItem } from "ui_context_menu.slint";

// A native window with a selectable presentation. It deliberately has no
// relationship to the AppWindow scene graph, so it can extend beyond the
// caller's bounds.
export component DetachedContextMenu inherits Window {
    title: "Context menu";
    no-frame: !root.use-native-frame;
    always-on-top: true;
    preferred-width: 204px;
    min-width: 204px;
    max-width: 204px;
    preferred-height: min(320px, 12px + root.items.length * 34px);
    min-height: 46px;
    max-height: 320px;
    background: #2a313d;

    in-out property <[ContextMenuItem]> items;
    // A Win32 frame retains the native DWM shadow for a square menu. Rounded
    // menus are frameless because their transparent alpha edge replaces it.
    in-out property <bool> use-native-frame: true;
    in-out property <length> corner-radius: 0px;
    callback item-triggered(string);

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #2a313d;
        border-color: #4a576b;
        border-width: 1px;
        border-radius: root.corner-radius;
        clip: true;

        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            for item in root.items : Rectangle {
                height: 32px;
                border-radius: 4px;
                background: row-hit.has-hover && item.enabled ? #3b4d64 : transparent;
                Text {
                    x: 10px;
                    text: item.label;
                    color: !item.enabled ? #6e7888 : (item.danger ? #ff9a9a : #e7edf6);
                    vertical-alignment: center;
                }
                row-hit := TouchArea {
                    enabled: item.enabled;
                    clicked => { root.item-triggered(item.id); }
                }
            }
        }
    }
}
