// REQUIRED: ui_top_bar.slint and Slint Window support. The host owns lifecycle
// and supplies title-text, message, topbar-show-*, topbar-height/title-size.
// Handle accepted(), dismissed(), minimize-requested(), maximize-requested();
// this component does not itself hide or run application actions. Optional
// Windows-specific manager: src/overlays/popup.rs with generated DetachedPopup.
// A real top-level Slint window. It is deliberately not embedded in AppWindow.
import { UiTopBar } from "ui_top_bar.slint";
export component DetachedPopup inherits Window {
    title: "Detached Slint popup";
    preferred-width: 420px;
    preferred-height: 250px;
    min-width: 320px;
    min-height: 190px;
    background: #202733;

    // Text in the custom title bar; the native Window title is separate.
    in-out property <string> title-text: "Detached popup";
    // Popup body text supplied by the host.
    in-out property <string> message: "This is a separate native window managed by PopupWindowManager.";
    // Independently control the three topbar buttons.
    in-out property <bool> topbar-show-minimize: false;
    in-out property <bool> topbar-show-maximize: false;
    in-out property <bool> topbar-show-close: true;
    // Visual bar height; native custom-frame geometry must be configured to match.
    in-out property <length> topbar-height: 46px;
    // Font size for the title-bar text.
    in-out property <length> topbar-title-size: 14px;
    // Host handles these actions and window visibility.
    callback accepted();
    callback dismissed();
    callback minimize-requested();
    callback maximize-requested();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #202733;

        VerticalLayout {
            padding: 0px;
            spacing: 14px;
            UiTopBar {
                title: root.title-text;
                show-minimize: root.topbar-show-minimize;
                show-maximize: root.topbar-show-maximize;
                show-close: root.topbar-show-close;
                bar-height: root.topbar-height;
                title-size: root.topbar-title-size;
                minimize-requested => { root.minimize-requested(); }
                maximize-requested => { root.maximize-requested(); }
                close-requested => { root.dismissed(); }
            }
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: #202733;
                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;
                    Text { text: root.message; color: #b5c0d0; wrap: word-wrap; vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 88px; height: 34px; border-radius: 5px; background: #374151;
                            Text { text: "Close"; color: #e2e8f0; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.dismissed(); } }
                        }
                        Rectangle {
                            width: 92px; height: 34px; border-radius: 5px; background: #3478c6;
                            Text { text: "Apply"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.accepted(); } }
                        }
                    }
                }
            }
        }
    }
}
