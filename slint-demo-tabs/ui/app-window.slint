import { UiTopBar } from "../../slint-demo-overlays/ui/ui_top_bar.slint";
import { UiTabGroup, UiTabWorkspace, TabItem } from "ui_tabs.slint";
import { UiTree, TreeNode } from "../../slint-demo-explorer/ui/ui_tree.slint";
import { UiList, ListColumn, ListRow } from "../../slint-demo-explorer/ui/ui_list.slint";
import { UiContextMenu } from "../../slint-demo-overlays/ui/ui_context_menu.slint";
export { TabItem } from "ui_tabs.slint";

export component AppWindow inherits Window {
    title: "Slint Document Groups Demo";
    background: transparent;
    preferred-width: 900px;
    preferred-height: 580px;
    min-width: 520px;
    min-height: 340px;
    in-out property <[TabItem]> primary-tabs;
    in-out property <[TabItem]> secondary-tabs;
    in-out property <string> primary-active-tab-id: "welcome";
    in-out property <string> secondary-active-tab-id: "";
    in-out property <bool> split-enabled: false;
    in-out property <float> split-ratio: 0.65;
    in-out property <string> new-tab-title: "";
    in-out property <string> status: "One document group. Use Split right to create another.";
    // Explorer is deliberately passed in through the host: UiTabGroup knows
    // neither filesystem data nor the modules rendered in its content slot.
    in-out property <[TreeNode]> explorer-tree-nodes;
    in-out property <[ListColumn]> explorer-list-columns;
    in-out property <[ListRow]> explorer-list-rows;
    in-out property <string> explorer-list-focused-id;
    in-out property <string> explorer-location;
    in-out property <string> explorer-operation-status;
    in-out property <bool> explorer-menu-open: false;
    in-out property <length> explorer-menu-x;
    in-out property <length> explorer-menu-y;
    callback tab-selected(string, string);
    callback tab-close-requested(string, string);
    callback split-right-requested();
    callback new-tab-requested(string);
    callback split-ratio-changed(float);
    callback explorer-navigate-up();
    callback explorer-navigate-to(string);
    callback explorer-tree-selected(string);
    callback explorer-tree-expansion-toggled(string);
    callback explorer-tree-activated(string);
    callback explorer-list-selected(string);
    callback explorer-list-selection-requested(string, int);
    callback explorer-list-drag-start-requested(string);
    callback explorer-list-selection-dragged(string);
    callback explorer-list-focus-requested(string);
    callback explorer-list-activated(string);
    callback explorer-list-context-menu-requested(string, length, length);
    callback explorer-list-command-requested(int);
    callback explorer-list-column-resized(string, length);
    callback window-minimize-requested();
    callback window-maximize-requested();
    callback window-close-requested();

    Rectangle {
        background: #171b22;
        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            UiTopBar {
                title: "Slint document groups";
                logo: "[]";
                show-minimize: true;
                show-maximize: true;
                show-close: true;
                minimize-tooltip: "Minimize";
                maximize-tooltip: "Maximize or restore";
                close-tooltip: "Close";
                minimize-requested => { root.window-minimize-requested(); }
                maximize-requested => { root.window-maximize-requested(); }
                close-requested => { root.window-close-requested(); }
            }
            Rectangle {
                height: 32px;
                background: #1c2530;
                Rectangle {
                    x: 8px;
                    y: 5px;
                    width: 94px;
                    height: 22px;
                    border-radius: 4px;
                    background: split-hit.has-hover ? #34465c : #28384b;
                    Text { text: root.split-enabled ? "Split active" : "Split right"; color: #dce7f5; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                    split-hit := TouchArea { mouse-cursor: pointer; clicked => { root.split-right-requested(); } }
                }
                Rectangle {
                    x: 112px;
                    y: 5px;
                    width: min(230px, parent.width - self.x - 92px);
                    height: 22px;
                    border-radius: 4px;
                    background: #111820;
                    border-color: #3a4b5f;
                    border-width: 1px;
                    TextInput {
                        x: 7px;
                        width: parent.width - 14px;
                        height: parent.height;
                        text <=> root.new-tab-title;
                        color: #dce7f5;
                        accepted => { root.new-tab-requested(self.text); }
                    }
                    Text {
                        visible: root.new-tab-title == "";
                        x: 7px;
                        width: parent.width - 14px;
                        height: parent.height;
                        text: "New tab title";
                        color: #718096;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    x: 348px;
                    y: 5px;
                    width: 78px;
                    height: 22px;
                    border-radius: 4px;
                    background: new-tab-hit.has-hover ? #3b5e81 : #2c4e70;
                    Text { text: "New tab"; color: #eff6ff; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                    new-tab-hit := TouchArea { mouse-cursor: pointer; clicked => { root.new-tab-requested(root.new-tab-title); } }
                }
                Text { x: 438px; width: parent.width - self.x - 10px; height: parent.height; text: "Each group has independently scrollable document tabs"; color: #91a0b5; font-size: 12px; vertical-alignment: center; }
            }
            workspace := UiTabWorkspace {
                vertical-stretch: 1;
                split-enabled: root.split-enabled;
                split-ratio <=> root.split-ratio;
                split-ratio-changed(ratio) => { root.split-ratio-changed(ratio); }
                UiTabGroup {
                    x: workspace.first-pane-x;
                    y: workspace.first-pane-y;
                    width: workspace.first-pane-width;
                    height: workspace.first-pane-height;
                    tabs: root.primary-tabs;
                    active-id <=> root.primary-active-tab-id;
                    if root.primary-active-tab-id == "explorer" : Rectangle {
                        // It deliberately occupies the viewport it receives
                        // from the tab. UiTree and UiList keep their own
                        // scrolling/input behavior inside this document.
                        // `parent` is the UiTabGroup itself (slot children
                        // resolve `parent` lexically), so size to the
                        // viewport it exposes, not to the whole group.
                        width: parent.content-width;
                        height: parent.content-height;
                        background: #171a21;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                Rectangle {
                                    width: 44px;
                                    border-radius: 4px;
                                    background: up-hit.has-hover ? #34465c : #28384b;
                                    Text { text: "Up"; color: #dce7f5; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                    up-hit := TouchArea { mouse-cursor: pointer; clicked => { root.explorer-navigate-up(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3a4b5f;
                                    background: #111820;
                                    location-input := TextInput {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        text: root.explorer-location;
                                        color: #dce7f5;
                                        accepted => { root.explorer-navigate-to(self.text); }
                                    }
                                }
                                Rectangle {
                                    width: 44px;
                                    border-radius: 4px;
                                    background: go-hit.has-hover ? #3b5e81 : #2c4e70;
                                    Text { text: "Go"; color: #eff6ff; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                    go-hit := TouchArea { mouse-cursor: pointer; clicked => { root.explorer-navigate-to(location-input.text); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                UiTree {
                                    width: 240px;
                                    nodes: root.explorer-tree-nodes;
                                    selected(id) => { root.explorer-tree-selected(id); }
                                    expansion-toggled(id) => { root.explorer-tree-expansion-toggled(id); }
                                    activated(id) => { root.explorer-tree-activated(id); }
                                }
                                UiList {
                                    horizontal-stretch: 1;
                                    columns: root.explorer-list-columns;
                                    rows: root.explorer-list-rows;
                                    focused-id: root.explorer-list-focused-id;
                                    corner-radius: 6px;
                                    status-visible: true;
                                    // Its contents remain caller-owned even
                                    // while UiList reserves the bottom strip.
                                    Rectangle {
                                        Text {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: parent.height;
                                            text: root.explorer-list-rows.length + " items";
                                            color: #aab5c6;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            x: parent.width / 2;
                                            width: parent.width / 2 - 8px;
                                            height: parent.height;
                                            text: root.explorer-operation-status;
                                            color: #aab5c6;
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    selected(id) => { root.explorer-list-selected(id); }
                                    selection-requested(id, mode) => { root.explorer-list-selection-requested(id, mode); }
                                    drag-start-requested(id) => { root.explorer-list-drag-start-requested(id); }
                                    selection-dragged(id) => { root.explorer-list-selection-dragged(id); }
                                    focus-requested(id) => { root.explorer-list-focus-requested(id); }
                                    activated(id) => { root.explorer-list-activated(id); }
                                    context-menu-requested(id, x, y) => { root.explorer-list-context-menu-requested(id, x, y); }
                                    command-requested(command) => { root.explorer-list-command-requested(command); }
                                    column-resized(id, width) => { root.explorer-list-column-resized(id, width); }
                                }
                            }
                        }
                    }
                    if root.primary-active-tab-id != "explorer" : Rectangle {
                        width: parent.content-width;
                        height: parent.content-height;
                        background: #1b222d;
                        Text { text: root.primary-active-tab-id == "" ? "Empty document group" : "Primary group: " + root.primary-active-tab-id; color: #aeb9c9; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    tab-selected(id) => { root.tab-selected("primary", id); }
                    tab-close-requested(id) => { root.tab-close-requested("primary", id); }
                }
                UiTabGroup {
                    visible: root.split-enabled;
                    x: workspace.second-pane-x;
                    y: workspace.second-pane-y;
                    width: workspace.second-pane-width;
                    height: workspace.second-pane-height;
                    tabs: root.secondary-tabs;
                    active-id <=> root.secondary-active-tab-id;
                    Rectangle {
                        background: #1b222d;
                        Text { text: root.secondary-active-tab-id == "" ? "Empty document group" : "Secondary group: " + root.secondary-active-tab-id; color: #aeb9c9; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    tab-selected(id) => { root.tab-selected("secondary", id); }
                    tab-close-requested(id) => { root.tab-close-requested("secondary", id); }
                }
            }
            Rectangle {
                height: 28px;
                background: #202733;
                Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.status; color: #91a0b5; font-size: 12px; vertical-alignment: center; }
            }
        }
        UiContextMenu {
            width: parent.width;
            height: parent.height;
            open: root.explorer-menu-open;
            anchor-x: root.explorer-menu-x;
            anchor-y: root.explorer-menu-y;
            items: [
                { id: "6", label: "Select all", shortcut: "Ctrl+A", enabled: true },
                { id: "7", label: "Clear selection", shortcut: "Esc", enabled: true },
                { id: "1", label: "Rename (not implemented)", shortcut: "F2", enabled: false },
                { id: "2", label: "Delete (not implemented)", shortcut: "Del", enabled: false },
                { id: "3", label: "Copy (not implemented)", shortcut: "Ctrl+C", enabled: false },
                { id: "4", label: "Cut (not implemented)", shortcut: "Ctrl+X", enabled: false },
                { id: "5", label: "Paste (not implemented)", shortcut: "Ctrl+V", enabled: false }
            ];
            item-triggered(id) => {
                root.explorer-menu-open = false;
                if (id == "6") { root.explorer-list-command-requested(6); }
                if (id == "7") { root.explorer-list-command-requested(7); }
            }
            dismissed => { root.explorer-menu-open = false; }
            replacement-requested(x, y) => { root.explorer-menu-open = false; }
        }
    }
}
